# =====================================================================
# NUR Invest — переменные окружения. Скопируйте в .env.local и заполните.
# Реальные секреты в репозиторий не коммитьте.
# =====================================================================

# --- Сайт ---------------------------------------------------------------
# Публичный адрес сайта (для SEO, sitemap и адресов возврата из банка).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Контакты (заполняет владелец; пустые поля на сайте не показываются) -
# WhatsApp: только цифры в международном формате, например 7XXXXXXXXXX.
# Пока пусто — кнопки WhatsApp ведут на форму заявки, плавающая кнопка скрыта.
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_CITY=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_WORKING_HOURS=

# --- Реквизиты продавца (футер, контакты, политика ПДн) -----------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_LEGAL_OGRN=
NEXT_PUBLIC_LEGAL_ADDRESS=

# --- Данные --------------------------------------------------------------
# Папка JSON-хранилища (по умолчанию ./.data). Нужен постоянный диск.
DATA_DIR=
# Создавать демонстрационные товары при первом запуске (true/false).
SEED_DEMO_PRODUCTS=true

# --- Админ-панель --------------------------------------------------------
# Случайная строка не короче 32 символов, например: openssl rand -base64 48
SESSION_SECRET=
# true — только если сайт стоит за вашим обратным прокси (nginx и т. п.),
# который выставляет X-Forwarded-For. Нужен для ограничения частоты запросов.
TRUST_PROXY=false

# --- Онлайн-оплата (T-Bank Интернет-эквайринг) --------------------------
# disabled — оплата выключена (по умолчанию); tbank — включить.
PAYMENTS_PROVIDER=disabled
# test — только тестовый терминал (ключ оканчивается на DEMO), без реальных списаний.
# live — боевой терминал, требует PAYMENTS_LIVE_CONFIRMED.
PAYMENTS_MODE=test
# Только после проверки оферты, договоров и условий юристом и шариатским экспертом:
# PAYMENTS_LIVE_CONFIRMED=I_CONFIRM_LEGAL_REVIEW
PAYMENTS_LIVE_CONFIRMED=
# Данные терминала из личного кабинета T-Bank Бизнес → Интернет-эквайринг → Магазины → Терминалы.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Адрес API (по умолчанию https://securepay.tinkoff.ru/v2).
TBANK_API_URL=
# Чеки 54-ФЗ через онлайн-кассу банка. Пусто — чек не передаётся.
# Система налогообложения: osn, usn_income, usn_income_outcome, esn, patent.
TBANK_RECEIPT_TAXATION=
# Ставка НДС: none, vat0, vat10, vat20 и др. — уточните у бухгалтера.
TBANK_RECEIPT_TAX=none
# Признаки расчёта. Пусто — автоматически: взнос = partial_prepayment/commodity,
# платежи по графику = credit_payment/payment. Обязательно согласуйте с бухгалтером.
TBANK_RECEIPT_PAYMENT_METHOD=
TBANK_RECEIPT_PAYMENT_OBJECT=

# Ключ шифрования серверных действий Next.js — нужен при нескольких экземплярах приложения.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
