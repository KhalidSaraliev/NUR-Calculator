DATABASE_URL="postgresql://nur_chat:nur_chat_password@localhost:5432/nur_chat?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000

# SMS-провайдер (заполнить при подключении реального провайдера)
SMS_PROVIDER_API_KEY=

# S3-совместимое хранилище (MinIO для локальной разработки)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nur-chat-files
